{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@src/*": ["./src/*"],
      "@utils/*": ["./src/utils/*"],
      "@controllers/*": ["./src/controller/*"],
      "@routes/*": ["./src/routes/*"],
      "@middlewares/*": ["./src/middleware/*"],
      "@validators/*": ["./src/validator/*"]
    }
  }
}
