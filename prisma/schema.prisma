 generator client {
   provider = "prisma-client-js"
   output   = "./generated/prisma"
 }

 datasource db {
   provider = "mysql"
   url      = env("DATABASE_URL")
 }

model User {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique
  email         String?   
  name          String?
  username      String?
  designation   String?
  departmentId  Int?
  locationId    Int?
  dateOfBirth   DateTime?
  avatar        String?
  mobile_prefix String    @default("+91")
  mobile        String?
  unitId        Int?
  about         String?   @db.Text
  password      String
  status        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations

  department Department? @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit       Unit?       @relation("UnitUsers", fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roles      Role[]      @relation("userroles")

  // Units relations
  unitsCreated Unit[] @relation("UnitCreatedBy")
  unitsUpdated Unit[] @relation("UnitUpdatedBy")

  // Department relations
  departmentsCreated Department[] @relation("DepartmentCreatedBy")
  departmentsUpdated Department[] @relation("DepartmentUpdatedBy")

  // Vendor relations
  vendorsCreated Vendor[] @relation("VendorCreatedBy")
  vendorsUpdated Vendor[] @relation("VendorUpdatedBy")

  // Brand relations
  brandsCreated Brand[] @relation("BrandCreatedBy")
  brandsUpdated Brand[] @relation("BrandUpdatedBy")

  // Category relations
  categoriesCreated Category[] @relation("CategoryCreatedBy")
  categoriesUpdated Category[] @relation("CategoryUpdatedBy")

  // Subcategory relations
  subcategoriesCreated Subcategory[] @relation("SubcategoryCreatedBy")
  subcategoriesUpdated Subcategory[] @relation("SubcategoryUpdatedBy")

  // SpecField relations
  specFieldsCreated SpecField[] @relation("SpecFieldCreatedBy")
  specFieldsUpdated SpecField[] @relation("SpecFieldUpdatedBy")

  // SpecFieldOption relations
  specFieldOptionsCreated SpecFieldOption[] @relation("SpecFieldOptionCreatedBy")
  specFieldOptionsUpdated SpecFieldOption[] @relation("SpecFieldOptionUpdatedBy")

  // Product relations
  productCreated Product[] @relation("ProductCreatedBy")
  productUpdated Product[] @relation("ProductUpdatedBy")

  // Product Spec Value
  productSpecValueCreated ProductSpecValue[] @relation("ProductSpecValueCreatedBy")
  productSpecValueUpdated ProductSpecValue[] @relation("ProductSpecValueUpdatedBy")

  //GR Details
  createdGRDetails GRDetail[] @relation("GRDetailCreatedBy")
  updatedGRDetails GRDetail[] @relation("GRDetailUpdatedBy")

  //GR Inventory Product
  createdGRInventoryProducts GRInventoryProduct[] @relation("GRInventoryProductCreatedBy")
  updatedGRInventoryProducts GRInventoryProduct[] @relation("GRInventoryProductUpdatedBy")

  //GR Product Spec Value
  createdGRProductSpecValues GRProductSpecValue[] @relation("GRProductSpecValueCreatedBy")
  updatedGRProductSpecValues GRProductSpecValue[] @relation("GRProductSpecValueUpdatedBy")

  //Inventory Product Detail
  createdInventoryProductDetails InventoryProductDetail[] @relation("InventoryProductDetailCreatedBy")
  updatedInventoryProductDetails InventoryProductDetail[] @relation("InventoryProductDetailUpdatedBy")

  // Address relations
  addressCreated Address[] @relation("AddressCreatedBy")
  addressUpdated Address[] @relation("AddressUpdatedBy")

  // ProductSoftwareInstalls relations
  productSoftwareInstallsCreated ProductSoftwareInstalls[] @relation("ProductSoftwareInstallsCreatedBy")
  productSoftwareInstallsUpdated ProductSoftwareInstalls[] @relation("ProductSoftwareInstallsUpdatedBy")

  // InstallationSoftware relations
  installationSoftwareCreated InstallationSoftware[] @relation("InstallationSoftwareCreatedBy")
  installationSoftwareUpdated InstallationSoftware[] @relation("InstallationSoftwareUpdatedBy")

  //ProductAssignment
  productAssignIssuer         ProductAssignment[] @relation("ProductIssuedBy")
  productAssignApprover       ProductAssignment[] @relation("ProductApprovedBy")
  productAssignAssignedToUser ProductAssignment[] @relation("ProductAssignedToUser")

  //ProductAssignmentLog
  productAssignmentPerformedBy ProductAssignmentLog[] @relation("ProductAssignmentPerformedBy")

  //ProductHandover
  productUserHandovers   ProductHandover[] @relation("UserHandovers")
  productIssuerHandovers ProductHandover[] @relation("IssuerHandovers")

  //Location
  locationCreated Location[] @relation("LocationCreatedBy")
  locationUpdated Location[] @relation("LocationUpdatedBy")

  location Location? @relation("UserLocation", fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  //UnitLocation
  unitLocationCreated UnitLocation[] @relation("UnitsLocationCreatedBy")
  unitLocationUpdated UnitLocation[] @relation("UnitsLocationUpdatedBy")

  // Ticket
  ticketCreated         Ticket[] @relation("CreatedByUser")
  ticketUpdated         Ticket[] @relation("UpdatedByUser")
  ticketApproved        Ticket[] @relation("ApprovedByUser")
  ticketSupportEngineer Ticket[] @relation("SupportEngineerUser")

  // service 
  serviceCreated Service[] @relation("ServiceCreatedBy")
  serviceUpdated Service[] @relation("ServiceUpdatedBy")

  logsCreated Log[] @relation("LogsCreatedBy")

  productTransferIssuedBy   ProductTransfer[] @relation("issuedBy")
  productTransferApprovedBy ProductTransfer[] @relation("approvedBy")
  productTransferCreatedBy  ProductTransfer[] @relation("createdBy")
  productTransferUpdatedBy  ProductTransfer[] @relation("updatedBy")

  productUnassignmentsCreated   ProductUnAssignment[] @relation("ProductUnAssignedByUser")
  productUnassignmentApprovedBy ProductUnAssignment[] @relation("ProductUnAssignedApprovedByUser")

  productAcceptancesApprovedBy ProductTranserAccept[]   @relation("ProductAcceptanceApprovedByUser")
  sapCodedAddedBy              InventoryProductDetail[] @relation("InventoryProductDetailSapCodeAddedBy")

  logReportCreatedBy LogReport[] @relation("LogReportCreatedBy")

  productRequestCreatedBy  ProductRequest[] @relation("ProductRequestCreatedBy")
  productRequestApprovedBy ProductRequest[] @relation("ProductRequestApprovedBy")

  notificationTo   Notification[]       @relation("NotificationUser")
  softCreatedBy    SoftWare[]           @relation("SoftwareCreatedBy")
  softUpdatedBy    SoftWare[]           @relation("SoftwareUpdatedBy")
  softAssignedTo   SoftWareAssignment[] @relation("SoftwareAssignedTo")
  softLogs         SoftWareLog[]        @relation("SoftwareLogUser")
  softwareAssigned SoftWareAssignment[] @relation("SoftwareAssignedBy")
  softwareUnassignmentsCreated SoftWareUnAssignment[] @relation("SoftwareUnAssignmentCreatedBy")

  EwasteRequestApprove  EwasteRequestApprove[] @relation("EwasteApprovedCreatedBy")
  EwasteRequestReviewer EwasteRequestApprove[] @relation("EwasteApprovedReviewedBy")
  EwasteRequestApprover EwasteRequestApprove[] @relation("EwasteApprovedApprovedBy")
  EwasteRequestIssuer   EwasteRequestApprove[] @relation("EwasteApprovedIssuedBy")

  mailConfigsUnitAdmin  MailConfig[] @relation("MailConfigUnitAdmin")
  mailConfigsSuperAdmin MailConfig[] @relation("MailConfigSuperAdmin")
  mailConfigsCreatedBy  MailConfig[] @relation("MailConfigCreatedBy")
  mailConfigsUpdatedBy  MailConfig[] @relation("MailConfigUpdatedBy")

  @@map("users")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String
  slug        String       @unique
  status      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[] @relation("rolepermissions")
  users       User[]       @relation("userroles")

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       Role[]   @relation("rolepermissions")

  @@map("permissions")
}

model Unit {
  id                   Int      @id @default(autoincrement())
  uuid                 String   @unique
  name                 String   @unique
  identificationNumber String?
  abbriviatedName      String?
  description          String?
  addressId            Int?
  status               Boolean  @default(true)
  createdBy            Int?
  updatedBy            Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  address                Address?                 @relation("UnitAddress", fields: [addressId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdUser            User?                    @relation("UnitCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedUser            User?                    @relation("UnitUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unitlocation           UnitLocation[]           @relation("UnitWithLocation")
  users                  User[]                   @relation("UnitUsers")
  inventoryProductDetail InventoryProductDetail[] @relation("UnitToProductDetail")
  tickets                Ticket[]                 @relation("Unit")
  productTransferFrom    ProductTransfer[]        @relation("productTransferForm")
  productTransferTo      ProductTransfer[]        @relation("productTransferTo")
  mailConfigs            MailConfig[]             @relation("MailConfigUnit")
  softwareAssignments    SoftWareAssignment[]     @relation("SoftwareAssignedToUnit")

  @@map("units")
}

model Department {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique
  name        String   @unique
  description String?
  status      Boolean  @default(true)
  createdBy   Int?
  updatedBy   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdUser User?  @relation("DepartmentCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedUser User?  @relation("DepartmentUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       User[]

  @@map("departments")
}

model Vendor {
  id                   Int      @id @default(autoincrement())
  uuid                 String   @unique
  identificationNumber String?
  name                 String   @unique
  email                String?
  gstNumber            String?
  vendorType           String?
  mobile               String?
  addressId            Int?
  contactPerson        String?
  contactNumber        String?
  bankName             String?
  bankAccountNumber    String?
  bankIfscCode         String?
  panNumber            String?
  status               Boolean  @default(true)
  createdBy            Int?
  updatedBy            Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  address     Address?   @relation("VendorAddress", fields: [addressId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdUser User?      @relation("VendorCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedUser User?      @relation("VendorUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grDetails   GRDetail[] @relation("VendorToGRDetail")

  @@map("vendors")
}

model Brand {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique
  name      String
  status    Boolean  @default(true)
  createdBy Int?
  updatedBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  createdUser User?     @relation("BrandCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedUser User?     @relation("BrandUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products    Product[]
  inventoryEntries GRInventoryProduct[] @relation("BrandToInventoryProducts")

  @@map("brands")
}

model Category {
  id                    Int      @id @default(autoincrement())
  uuid                  String   @unique @default(uuid())
  name                  String
  description           String?
  assetType             String   @default("PHYSICAL") // PHYSICAL or DIGITAL
  trackingType          String   @default("TRACKABLE") // TRACKABLE or NON_TRACKABLE
  abbriviatedName       String?
  maintainanceFrequency Int?
  status                Boolean  @default(true)
  createdBy             Int?
  updatedBy             Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  createdUser        User?               @relation("CategoryCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedUser        User?               @relation("CategoryUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subcategories      Subcategory[]
  products           Product[]
  categorySpecFields CategorySpecField[]
  inventoryEntries   GRInventoryProduct[] @relation("CategoryToInventoryProducts")

  @@map("categories")
}

model Subcategory {
  id                    Int      @id @default(autoincrement())
  uuid                  String   @unique @default(uuid())
  categoryId            Int
  name                  String
  description           String?
  abbriviatedName       String?
  status                Boolean  @default(true)
  maintainanceFrequency Int?
  createdBy             Int?
  updatedBy             Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  createdUser User?    @relation("SubcategoryCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedUser User?    @relation("SubcategoryUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  subcategorySpecFields SubcategorySpecField[] //  manual join relation
  @@map("subcategories")
}

model SpecField {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  name        String
  fieldType   String
  unit        String?
  isRequired  Boolean  @default(false)
  description String?
  status      Boolean  @default(true)
  createdBy   Int?
  updatedBy   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdUser User? @relation("SpecFieldCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedUser User? @relation("SpecFieldUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  subcategorySpecFields SubcategorySpecField[] //  manual join relation
  categorySpecFields    CategorySpecField[]    //  category join relation
  options               SpecFieldOption[]
  productSpecValue      ProductSpecValue[]
  grProductSpecValues   GRProductSpecValue[]   @relation("GRProductSpecValueToSpecField")

  @@map("spec_fields")
}

//  This is your explicit join table
model SubcategorySpecField {
  subcategoryId Int
  specFieldId   Int

  subcategory Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  specField   SpecField   @relation(fields: [specFieldId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([subcategoryId, specFieldId])
}

// Category-SpecField join table (replaces subcategory-based spec linking)
model CategorySpecField {
  categoryId  Int
  specFieldId Int

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  specField SpecField  @relation(fields: [specFieldId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([categoryId, specFieldId])
  @@map("category_spec_fields")
}

model SpecFieldOption {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  specFieldId Int
  value       String
  status      Boolean  @default(true)
  createdBy   Int?
  updatedBy   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdUser User?     @relation("SpecFieldOptionCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedUser User?     @relation("SpecFieldOptionUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  specField   SpecField @relation(fields: [specFieldId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("spec_field_options")
}

// subcategoryId  Int?

model Product {
  id             Int      @id @default(autoincrement())
  uuid           String   @unique
  brandId        Int
  categoryId     Int
  name           String
  msq            String?
  serialNo       String?
  costPrice      Decimal?
  description    String?
  lifeCycleAging Int?
  status         Boolean  @default(true)
  createdBy      Int?
  updatedBy      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  createdUser      User?                @relation("ProductCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedUser      User?                @relation("ProductUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  brand            Brand                @relation(fields: [brandId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category         Category             @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productSpecValue ProductSpecValue[]
  inventoryEntries GRInventoryProduct[] @relation("ProductToInventoryProducts")

  @@map("products")
}

model ProductSpecValue {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  productId   Int
  specFieldId Int
  value       String
  status      Boolean  @default(true)
  createdBy   Int?
  updatedBy   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdUser User?     @relation("ProductSpecValueCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedUser User?     @relation("ProductSpecValueUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product     Product   @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  specField   SpecField @relation(fields: [specFieldId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("product_spec_values")
}

model GRDetail {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(uuid())
  sapId         String?
  sapDate       DateTime?
  invoiceNumber String?
  invoiceDate   DateTime?
  grId          String?
  grDate        DateTime?
  vendorId      Int?

  description String?
  invoiceFile String?
  isTagged    Boolean  @default(false)
  status      Boolean  @default(true)
  createdBy   Int
  updatedBy   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor            Vendor?              @relation("VendorToGRDetail", fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdUser       User                 @relation("GRDetailCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedUser       User                 @relation("GRDetailUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventoryProducts GRInventoryProduct[] @relation("GRDetailToInventoryProducts")

  @@map("gr_details")
}

model GRInventoryProduct {
  id                   Int       @id @default(autoincrement())
  uuid                 String    @unique @default(uuid())
  grDetailsId          Int
  productId            Int?
  categoryId           Int?
  brandId              Int?
  quantity             Int
  ratePerPiece         Float
  freeQty              Int
  description          String?
  maintenanceFrequency String?
  maintenanceDueDate   DateTime?
  lifecycleExDate      DateTime?
  warrantyTill         DateTime?
  warrantyFile         String?
  totalAmount          Float
  grossAmount          Float?
  taxPercent           Float?    @default(18)
  taxAmount            Float?
  netAmount            Float?
  importantLink        String?
  invoiceFile          String?
  status               Boolean   @default(true)
  nextServiceDate      DateTime?
  createdBy            Int
  updatedBy            Int
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  grDetails        GRDetail                 @relation("GRDetailToInventoryProducts", fields: [grDetailsId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product          Product?                 @relation("ProductToInventoryProducts", fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category         Category?                @relation("CategoryToInventoryProducts", fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  brand            Brand?                   @relation("BrandToInventoryProducts", fields: [brandId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdUser      User                     @relation("GRInventoryProductCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedUser      User                     @relation("GRInventoryProductUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventoryDetails InventoryProductDetail[] @relation("InventoryProductDetailToGRInventoryProduct")

  @@map("gr_inventory_products")
}

model GRProductSpecValue {
  id                         Int      @id @default(autoincrement())
  uuid                       String   @unique @default(uuid())
  grInventoryProductDetailId Int?
  specFieldId                Int
  value                      String
  status                     Boolean  @default(true)
  createdBy                  Int
  updatedBy                  Int
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  grInventoryProductDetail InventoryProductDetail? @relation("GRProductSpecValueToInventoryProductDetail", fields: [grInventoryProductDetailId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  specField                SpecField               @relation("GRProductSpecValueToSpecField", fields: [specFieldId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdUser              User                    @relation("GRProductSpecValueCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedUser              User                    @relation("GRProductSpecValueUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("gr_product_spec_values")
}

model InventoryProductDetail {
  id                     Int       @id @default(autoincrement())
  uuid                   String    @unique @default(uuid())
  grInventoryProductId   Int
  serialNo1              String?
  serialNo2              String?
  sapCode                String?
    modelName              String?
  isFree                 Boolean   @default(false)
  assignedStatus         String    @default("InStock")
  previousAssignedStatus String?
  isUsed                 Boolean   @default(false)
  lifecycleExDate        DateTime?
  maintenanceDueDate     DateTime?
  nextServiceDate        DateTime?
  status                 Boolean   @default(true)
  installationStatus     Boolean   @default(false)
  locationId             Int?
  unitId                 Int?
  createdBy              Int
  sapCodeAddedBy         Int?
  sapCodeAddedAt         DateTime?
  updatedBy              Int
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  softwareInstalls     ProductSoftwareInstalls[] @relation("ProductSoftwareInstallsToProducts")
  AssignProductDetails ProductAssignment[]
  transferDetails      ProductTransfer[]
  ticketAssets         TicketAsset[]
  services             Service[]                 @relation("ServiceToInventoryProductDetail")
  grInventoryProduct   GRInventoryProduct        @relation("InventoryProductDetailToGRInventoryProduct", fields: [grInventoryProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  qrCode               InventoryProductQr?       @relation("InventoryProductQrToProductDetail")
  createdUser          User                      @relation("InventoryProductDetailCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedUser          User                      @relation("InventoryProductDetailUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  specValues           GRProductSpecValue[]      @relation("GRProductSpecValueToInventoryProductDetail")
  location             Location?                 @relation("LocationToInventoryProductDetail", fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  sapCodeAddedByUser   User?                 @relation("InventoryProductDetailSapCodeAddedBy", fields: [sapCodeAddedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit                 Unit?                 @relation("UnitToProductDetail", fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productUnassignments ProductUnAssignment[] @relation("ProductUnAssignmentToInventoryProductDetail")
  productRequests      ProductRequest[]      @relation("ProductRequestInventoryProductDetails")

  logs       ProductAssignmentLog[]
  logReports LogReport[]            @relation("LogReportProduct")

  @@map("inventory_products_details")
}

model InventoryProductQr {
  id                       Int    @id @default(autoincrement())
  uuid                     String @unique @default(uuid())
  inventoryProductDetailId Int    @unique
  qrCodeUrl                String

  inventoryProductDetail InventoryProductDetail @relation("InventoryProductQrToProductDetail", fields: [inventoryProductDetailId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model InstallationSoftware {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  name      String
  version   String?
  status    Boolean  @default(true)
  required  Boolean  @default(true)
  createdBy Int
  updatedBy Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdUser           User                      @relation("InstallationSoftwareCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedUser           User                      @relation("InstallationSoftwareUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productInstalledSofts ProductSoftwareInstalls[] @relation("ProductSoftwareInstallsToInstallationSoftware")

  @@map("installation_softwares")
}

model ProductSoftwareInstalls {
  id                         Int      @id @default(autoincrement())
  uuid                       String   @unique @default(uuid())
  installationId             String?
  grInventoryProductDetailId Int?
  softwareId                 Int
  value                      String?
  installedAt                DateTime @default(now())
  installedBy                Int
  updatedBy                  Int
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  status                     Boolean  @default(true)

  createdUser User                    @relation("ProductSoftwareInstallsCreatedBy", fields: [installedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedUser User                    @relation("ProductSoftwareInstallsUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product     InventoryProductDetail? @relation("ProductSoftwareInstallsToProducts", fields: [grInventoryProductDetailId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  softwares   InstallationSoftware?   @relation("ProductSoftwareInstallsToInstallationSoftware", fields: [softwareId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("product_software_installs")
}

model ProductAssignment {
  id                       Int       @id @default(autoincrement())
  uuid                     String    @unique @default(uuid())
  inventoryProductDetailId Int
  assignedId               String?
  assignedToUserId         Int?
  assignedToLocationId     Int?
  issuerId                 Int
  approverId               Int?
  productHandoverId        Int?
  startDate                DateTime
  endDate                  DateTime?
  isExtended               Boolean   @default(false)
  status                   String    @default("Active")
  notes                    String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Relations
  inventoryProductDetail InventoryProductDetail @relation(fields: [inventoryProductDetailId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedToUser         User?                  @relation("ProductAssignedToUser", fields: [assignedToUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
